---
const marscoinUrl = 'https://www.marscoinbnb.com/';
const marscoinFlapUrl = 'https://flap.sh/bnb/0xfe189e97832da1573e4e4ff034f4ffc3a15c7777';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#1d181b" />
    <meta name="description" content="MOSS went dark at 1%. MarsCoin brought him back. Now he searches Mars for the coin that keeps him alive." />
    <meta property="og:title" content="MOSS / MARSCOIN" />
    <meta property="og:description" content="One coin brought him back. Now he's looking for the rest." />
    <meta property="og:image" content="https://mossinmars.github.io/assets/moss-banner.png" />
    <meta property="og:url" content="https://mossinmars.github.io/" />
    <link rel="icon" href="/assets/moss-dp.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Michroma&family=Orbitron:wght@700;800;900&display=swap" rel="stylesheet" />
    <script is:inline>document.documentElement.classList.add('has-js');</script>
    <title>MOSS / MARSCOIN — The search begins</title>
  </head>
  <body>
    <div class="page-shell">
      <header class="site-header" id="top">
        <a class="header-brand" href="#top" aria-label="MOSS home">MOSS<span class="header-slash">/</span><span>MARSCOIN</span></a>
        <nav aria-label="Main navigation">
          <a href="#story">Story</a>
          <a href="#pair">The search</a>
          <a href="#rewards">Rewards</a>
          <a href="#expedition">Expedition</a>
        </nav>
        <a class="header-action" href="#find-moss">Find MOSS <span aria-hidden="true">↗</span></a>
      </header>

      <main>
        <section class="hero" aria-labelledby="hero-title">
          <div class="hero-glow" aria-hidden="true"></div>
          <div class="hero-image" aria-hidden="true">
            <img src="/assets/moss-hero.png" alt="" fetchpriority="high" />
          </div>
          <div class="hero-grid" aria-hidden="true"></div>
          <div class="hero-content">
            <div class="eyebrow"><span class="status-dot"></span> INCOMING TRANSMISSION <span class="eyebrow-divider">/</span> BNB CHAIN</div>
            <h1 id="hero-title">MOSS<span class="hero-slash">/</span><span class="hero-marscoin">MARSCOIN</span></h1>
            <p class="hero-line">He ran out of power.<br /><em>Mars had other plans.</em></p>
            <p class="hero-support">One coin brought him back. Now he's looking for the rest.</p>
            <div class="hero-actions">
              <a class="button button-primary" href="#story">Follow the signal <span aria-hidden="true">↘</span></a>
              <a class="button button-ghost" href="#expedition">Preview Expedition <span aria-hidden="true">↗</span></a>
            </div>
          </div>
          <div class="hero-bottom">
            <span>TRANSMISSION // 001</span>
            <span>SCROLL TO CONTINUE <span aria-hidden="true">↓</span></span>
          </div>
        </section>

        <section class="signal-section" id="story" aria-labelledby="story-title">
          <div class="blackout-scene" aria-hidden="true"><img src="/assets/moss-recharged.png" alt="" loading="lazy" /></div>
          <div class="mobile-charge" aria-hidden="true"><span>PWR</span><span class="mobile-charge-bars">▮▮▮▮▮▮▮▮</span><span>100%</span></div>
          <div class="section-frame">
            <p class="section-kicker">01 / THE LAST PERCENT</p>
            <div class="signal-content">
              <div class="story-copy">
                <h2 id="story-title">MOSS DIED HERE.<br /><em>THE COIN DISAGREED.</em></h2>
                <p>No signal. No sun. One percent left. MOSS stopped beside a strange object in the dust. His lights went out.</p>
                <p>When they came back, his battery read 100%. The object was MarsCoin.</p>
                <a class="button button-ghost lore-button" href="https://x.com/AndrewOnXYZ/status/2102512879258009818" target="_blank" rel="noopener noreferrer">THE LORE <span aria-hidden="true">↗</span></a>
              </div>
            </div>
          </div>
        </section>

        <section class="pair-section" id="pair" aria-labelledby="pair-title">
          <div class="pair-scene" aria-hidden="true"><img src="/assets/moss-finds-marscoin-blue-sunset.png" alt="" loading="lazy" /></div>
          <div class="section-frame pair-layout">
            <div class="pair-copy">
              <p class="section-kicker">02 / THE NEW MISSION</p>
              <h2 id="pair-title">ONE COIN WOKE HIM.<br /><em>HE NEEDS<br />THE REST.</em></h2>
              <p class="pair-lead">MarsCoin gave MOSS a full charge. More are out there. He no longer drives for Earth; he searches Mars for the coins that keep him alive.</p>
              <p class="pair-coordinates">MOSS / MARSCOIN <span>·</span> FLAP <span>·</span> BNB CHAIN</p>
            </div>
            <a class="marscoin-identity" href={marscoinUrl} target="_blank" rel="noopener noreferrer" aria-label="Visit the official MarsCoin website">
              <img src="/assets/marscoin-official-icon.png" alt="MarsCoin's official orange planet coin logo" loading="lazy" />
              <span><strong>MARSCOIN</strong><small>OFFICIAL BNB COIN <span aria-hidden="true">↗</span></small></span>
            </a>
          </div>
        </section>

        <section class="rewards-section" id="rewards" aria-labelledby="rewards-title">
          <div class="section-frame rewards-layout">
            <div class="reward-heading">
              <p class="section-kicker">03 / THE MISSION ECONOMY</p>
              <h2 id="rewards-title">KEEP THE<br /><em>MISSION MOVING.</em></h2>
              <p>MarsCoin for the crew. Fuel for the Expedition. A longer road for MOSS.</p>
            </div>
            <div class="reward-total">
              <div class="reward-number" aria-label="3 percent total fee">3<span>%</span></div>
              <p class="reward-total-label">TOTAL PLANNED FEE</p>
              <div class="mechanics-breakdown" aria-label="Planned 3 percent fee breakdown">
                <div class="mechanic-row">
                  <span class="mechanic-value">2%</span>
                  <div><h3>HOLDER REWARDS</h3><p>MarsCoin rewards distributed to MOSS holders.</p></div>
                </div>
                <div class="mechanic-row">
                  <span class="mechanic-value">0.5%</span>
                  <div><h3>EXPEDITION FUND</h3><p>Funds game development, infrastructure, daily leaderboard rewards, and future expansion.</p></div>
                </div>
                <div class="mechanic-row">
                  <span class="mechanic-value">0.5%</span>
                  <div><h3>DEVELOPMENT</h3><p>Supports development, infrastructure, content, website operations, and MOSS expansion.</p></div>
                </div>
              </div>
            </div>
            <div class="reward-side">
              <div class="dividend-scenarios">
                <table>
                  <caption>What a 2% holder rewards pool could look like</caption>
                  <thead><tr><th scope="col">Eligible volume</th><th scope="col">Illustrative pool</th></tr></thead>
                  <tbody>
                    <tr><td>$1M</td><td>$20K</td></tr>
                    <tr><td>$10M</td><td>$200K</td></tr>
                    <tr><td>$100M</td><td>$2M</td></tr>
                  </tbody>
                </table>
                <p class="scenario-note">2% × eligible volume, shown as a total USD equivalent. Actual MarsCoin rewards depend on launch settings, fees and swaps. These are not per-holder payouts.</p>
              </div>
              <div class="reward-asset"><img src="/assets/marscoin-official-icon.png" alt="" loading="lazy" /><span>HOLDER REWARDS<br />IN MARSCOIN</span></div>
            </div>
          </div>
        </section>

        <section class="expedition-section" id="expedition" aria-labelledby="expedition-title">
          <div class="section-frame expedition-inner">
            <div class="expedition-intro">
              <h2 id="expedition-title" aria-label="MarsCoin Expedition">
                <span class="expedition-title-main" aria-hidden="true"><span>MARSC</span><img src="/assets/marscoin-official-icon.png" alt="" width="124" height="124" /><span>IN</span></span>
                <span class="expedition-title-sub" aria-hidden="true">EXPEDITION</span>
              </h2>
              <p class="expedition-tagline">Every MarsCoin matters. Keep MOSS alive.</p>
            </div>
            <div class="expedition-grid">
              <figure class="expedition-preview">
                <div class="expedition-preview-frame"><img src="/assets/marscoin-expedition-gameplay.png" alt="Gameplay concept: a third-person view behind MOSS driving across rocky Mars terrain toward a scarce MarsCoin, with battery, distance, and score indicators." width="1672" height="941" loading="lazy" decoding="async" /></div>
                <figcaption>GAMEPLAY CONCEPT <span>·</span> THIRD-PERSON ROVER SURVIVAL</figcaption>
              </figure>
              <div class="expedition-features">
                <article class="expedition-feature">
                  <img class="expedition-feature-art" src="/assets/expedition-card-scarce.png" alt="" width="1672" height="941" loading="lazy" decoding="async" />
                  <div class="expedition-feature-copy"><span class="feature-index">01 / SURVIVE</span><h3>SCARCE<br />MARSCOIN</h3><p>Find the next coin before MOSS runs out of power.</p></div>
                </article>
                <article class="expedition-feature">
                  <img class="expedition-feature-art" src="/assets/expedition-card-leaderboard.png" alt="" width="1672" height="941" loading="lazy" decoding="async" />
                  <div class="expedition-feature-copy"><span class="feature-index">02 / COMPETE</span><h3>DAILY<br />LEADERBOARD</h3><p>Every day brings a fresh race across Mars.</p></div>
                </article>
                <article class="expedition-feature">
                  <img class="expedition-feature-art" src="/assets/expedition-card-rewards.png" alt="" width="1672" height="941" loading="lazy" decoding="async" />
                  <div class="expedition-feature-copy"><span class="feature-index">03 / WIN</span><h3>TOP SCORE.<br />DAILY REWARD.</h3><p>The highest score takes the day's reward.</p></div>
                </article>
              </div>
            </div>
            <div class="expedition-footer"><button class="button button-disabled" type="button" disabled>COMING SOON</button><span>MISSION STATUS / IN DEVELOPMENT</span></div>
          </div>
        </section>

        <section class="final-section" id="find-moss" aria-labelledby="final-title">
          <div class="final-horizon" aria-hidden="true"></div>
          <div class="section-frame final-content">
            <p class="section-kicker">05 / TRANSMISSION CONTINUES</p>
            <h2 id="final-title">FIND<br /><em>MOSS.</em></h2>
            <p>The search begins soon. Launch coordinates are being set; check the contract before you trade.</p>
            <div class="launch-facts">
              <div><span>CHAIN</span><strong>BNB CHAIN</strong></div>
              <div><span>LAUNCHPAD</span><strong>FLAP</strong></div>
              <div><span>PAIR</span><strong>MOSS / MARSCOIN · PLANNED</strong></div>
              <div><span>MOSS CONTRACT</span><strong>TO BE ANNOUNCED</strong></div>
            </div>
            <div class="final-actions">
              <span class="button button-disabled" aria-disabled="true">BUY MOSS · SOON</span>
              <a class="button button-ghost" href={marscoinFlapUrl} target="_blank" rel="noopener noreferrer">View MarsCoin on Flap <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </section>
      </main>

      <footer class="site-footer">
        <span>MOSS / MARSCOIN</span>
        <span>THE MISSION ENDED. THE SEARCH BEGAN.</span>
        <a href="#top">BACK TO TOP ↑</a>
      </footer>
    </div>
    <script>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.14 });
      document.querySelectorAll('.signal-content, .pair-layout, .rewards-section .section-frame, .expedition-inner, .final-content').forEach((el) => observer.observe(el));
      const hero = document.querySelector('.hero');
      const heroImage = document.querySelector('.hero-image');
      if (hero && heroImage && window.matchMedia('(pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
        hero.addEventListener('pointermove', (event) => {
          const x = (event.clientX / window.innerWidth - 0.5) * 14;
          const y = (event.clientY / window.innerHeight - 0.5) * 10;
          heroImage.style.setProperty('--pointer-x', `${x}px`);
          heroImage.style.setProperty('--pointer-y', `${y}px`);
        }, { passive: true });
      }
    </script>
  </body>
</html>

<style is:global>
  :root { color-scheme: dark; --ink:#1d181b; --deep:#211c21; --mauve:#69575b; --dust:#a67b6d; --sand:#f5dbc7; --paper:#f5e9df; --cyan:#9ae8ef; --line:rgba(245,219,199,.24); font-family:'DM Sans',Arial,sans-serif; }
  * { box-sizing:border-box; }
  html { scroll-behavior:smooth; }
  body { margin:0; background:var(--ink); color:var(--paper); }
  a { color:inherit; text-decoration:none; }
  button,a { -webkit-tap-highlight-color:transparent; }
  ::selection { background:var(--cyan); color:var(--ink); }
  .page-shell { overflow:hidden; }
  .site-header { height:88px; padding:0 clamp(22px,4.8vw,84px); display:flex; align-items:center; justify-content:space-between; gap:30px; position:absolute; z-index:20; width:100%; border-bottom:1px solid rgba(255,235,222,.15); background:linear-gradient(180deg,rgba(25,21,24,.58),transparent); }
  .header-brand { font:700 18px/1 'Michroma',sans-serif; white-space:nowrap; letter-spacing:-.065em; }
  .header-brand span:last-child { font-size:11px; letter-spacing:.11em; font-weight:400; }
  .header-slash { color:var(--sand); padding:0 8px; font-weight:400; }
  .site-header nav { display:flex; gap:36px; font-size:12px; text-transform:uppercase; letter-spacing:.16em; color:#f3ddd1; }
  .site-header nav a, .site-footer a { transition:color .2s ease; }
  .site-header nav a:hover,.site-footer a:hover { color:var(--cyan); }
  .header-action { border:1px solid rgba(255,235,222,.4); border-radius:2px; padding:13px 17px; font-size:11px; letter-spacing:.13em; text-transform:uppercase; transition:background .2s ease,color .2s ease; white-space:nowrap; }
  .header-action:hover { background:var(--paper); color:var(--ink); }
  .header-action span { margin-left:11px; }
  .hero { min-height:760px; height:100svh; max-height:1100px; isolation:isolate; position:relative; background:radial-gradient(circle at 77% 55%,#a76f62 0,#685458 42%,#292227 83%); display:flex; align-items:center; }
  .hero-glow { position:absolute; inset:0; z-index:-2; background:radial-gradient(circle at 68% 58%,rgba(255,186,132,.46),transparent 37%); }
  .hero-image { --pointer-x:0px; --pointer-y:0px; position:absolute; inset:0; z-index:-2; overflow:hidden; transform:translate(var(--pointer-x),var(--pointer-y)) scale(1.035); transition:transform .32s ease-out; }
  .hero-image img { width:100%; height:100%; object-fit:cover; object-position:50% 44%; filter:saturate(.84) contrast(1.03) brightness(.78); }
  .hero::after { content:""; position:absolute; inset:0; z-index:-1; pointer-events:none; background:linear-gradient(90deg,rgba(27,23,27,.87) 0%,rgba(34,28,31,.58) 34%,rgba(34,28,31,.07) 70%),linear-gradient(0deg,#211c21 0%,transparent 18%,transparent 78%,rgba(28,25,28,.27) 100%); }
  .hero-grid { position:absolute; inset:0; z-index:-1; opacity:.15; background-image:linear-gradient(90deg,transparent calc(50% - .5px),rgba(255,239,221,.3) 50%,transparent calc(50% + .5px)); background-size:25% 100%; }
  .hero-content { width:min(100%,810px); padding:112px 0 75px clamp(25px,7.4vw,138px); position:relative; }
  .eyebrow,.section-kicker,.hero-bottom,.launch-facts span,.site-footer { font-size:11px; letter-spacing:.23em; text-transform:uppercase; font-weight:700; }
  .eyebrow { display:flex; align-items:center; gap:12px; color:#f6e3d4; margin-bottom:35px; white-space:nowrap; }
  .status-dot { height:7px; width:7px; flex:0 0 7px; background:var(--cyan); border-radius:50%; box-shadow:0 0 11px var(--cyan); animation:blink 3s infinite; }
  .eyebrow-divider { opacity:.5; }
  h1,h2,p { margin-top:0; }
  h1,h2 { font-family:'Michroma',Arial,sans-serif; font-weight:400; }
  .hero h1 { font-size:clamp(48px,6.6vw,114px); line-height:1; letter-spacing:-.085em; margin:0 0 45px; white-space:nowrap; text-shadow:0 3px 40px rgba(22,19,23,.15); }
  .hero-slash { display:inline-block; font-size:.8em; font-weight:400; padding:0 .17em 0 .2em; color:var(--sand); }
  .hero-marscoin { display:inline-block; font-size:.39em; letter-spacing:.06em; font-weight:400; vertical-align:.1em; }
  .hero-line { font-size:clamp(30px,3.1vw,58px); line-height:1.2; letter-spacing:-.045em; color:var(--paper); font-weight:500; margin-bottom:19px; }
  .hero-line em, .signal-section h2 em,.rewards-section h2 em,.final-section h2 em { font-style:normal; color:var(--sand); }
  .hero-support { font-size:16px; color:#e6d0c5; margin-bottom:31px; }
  .hero-actions,.final-actions { display:flex; gap:11px; flex-wrap:wrap; }
  .button { min-height:52px; display:inline-flex; align-items:center; justify-content:space-between; gap:30px; padding:0 22px; border:1px solid var(--paper); font-size:11px; text-transform:uppercase; letter-spacing:.13em; font-weight:700; transition:transform .2s ease,background .2s ease,color .2s ease; }
  a.button:hover { transform:translateY(-3px); }
  .button-primary { background:var(--paper); color:#342b2c; }
  .button-primary:hover { background:#fff; }
  .button-ghost { color:var(--paper); background:rgba(30,25,29,.21); }
  .button-ghost:hover { background:rgba(255,255,255,.12); }
  .hero-bottom { position:absolute; left:clamp(25px,7.4vw,138px); right:clamp(25px,4.8vw,84px); bottom:33px; display:flex; justify-content:space-between; color:#f6e0d2; opacity:.75; }
  .hero-bottom span:last-child span { margin-left:13px; }
  .section-frame { max-width:1600px; margin:auto; padding-left:clamp(24px,7.4vw,138px); padding-right:clamp(24px,7.4vw,138px); }
  .section-kicker { color:var(--dust); margin-bottom:68px; }
  .signal-section { min-height:820px; position:relative; padding:112px 0 126px; background:#0c101d; overflow:hidden; isolation:isolate; display:flex; align-items:center; }
  .blackout-scene { position:absolute; inset:0; z-index:-2; }
  .blackout-scene img { display:block; width:100%; height:100%; object-fit:cover; object-position:48% 58%; filter:brightness(.9) contrast(1.08); }
  .mobile-charge { display:none; }
  .signal-section::after { content:""; position:absolute; inset:0; z-index:-1; pointer-events:none; background:linear-gradient(90deg,rgba(9,13,25,.3) 0%,rgba(9,13,25,.16) 42%,rgba(9,13,25,.78) 66%,rgba(9,13,25,.9) 100%),linear-gradient(0deg,#10111c 0%,transparent 28%,rgba(8,12,25,.25) 100%); }
  .signal-section .section-frame { width:100%; position:relative; z-index:1; }
  .signal-section .section-kicker { color:#b4c9d6; text-align:right; }
  .signal-content { display:flex; justify-content:flex-end; align-items:end; min-height:525px; position:relative; opacity:0; transform:translateY(35px); transition:opacity .7s ease,transform .7s ease; }
  .signal-content.is-visible,.pair-layout.is-visible,.rewards-section .section-frame.is-visible,.expedition-inner.is-visible,.final-content.is-visible { opacity:1; transform:translateY(0); }
  .story-copy { width:min(100%,570px); text-shadow:0 2px 20px rgba(4,8,18,.75); }
  .story-copy h2,.pair-copy h2,.rewards-section h2,.final-section h2 { font-size:clamp(36px,4.3vw,70px); line-height:1.28; letter-spacing:-.07em; }
  .story-copy h2 { font-size:clamp(33px,3.5vw,56px); }
  .story-copy p { max-width:540px; font-size:clamp(17px,1.5vw,22px); line-height:1.65; color:#ecd9d1; }
  .story-copy p:last-of-type { color:var(--sand); }
  .lore-button { margin-top:18px; }
  .pair-section { min-height:780px; position:relative; isolation:isolate; overflow:hidden; display:flex; align-items:center; color:var(--paper); background:#282027; }
  .pair-scene { position:absolute; inset:0; z-index:-2; }
  .pair-scene img { width:100%; height:100%; display:block; object-fit:cover; object-position:56% 47%; filter:saturate(.92) brightness(.9); }
  .pair-section::after { content:""; position:absolute; inset:0; z-index:-1; pointer-events:none; background:linear-gradient(90deg,rgba(13,24,44,.74) 0%,rgba(19,27,44,.68) 36%,rgba(24,20,25,.08) 76%),linear-gradient(0deg,rgba(24,20,25,.78),transparent 27%); }
  .pair-layout { width:100%; min-height:780px; display:grid; grid-template-columns:minmax(0,770px) 1fr; gap:30px; align-items:end; padding-top:135px; padding-bottom:102px; opacity:0; transform:translateY(35px); transition:opacity .7s ease,transform .7s ease; }
  .pair-copy { align-self:center; text-shadow:0 2px 18px rgba(9,12,22,.65); }
  .pair-copy .section-kicker { margin-bottom:36px; color:#d3a99e; }
  .pair-copy h2 { max-width:850px; font-size:clamp(33px,3.4vw,58px); margin-bottom:34px; line-height:1.35; }
  .pair-copy h2 em { font-style:normal; color:var(--sand); }
  .pair-lead { max-width:520px; font-size:clamp(17px,1.45vw,22px); line-height:1.65; color:#f0d9cf; margin-bottom:42px; }
  .pair-coordinates { display:inline-block; border-top:1px solid rgba(248,225,210,.58); padding-top:14px; font-size:11px; font-weight:700; letter-spacing:.16em; color:#f6dfd1; }
  .pair-coordinates span { color:var(--cyan); padding:0 7px; }
  .marscoin-identity { justify-self:end; align-self:end; display:flex; align-items:center; gap:17px; padding:10px 22px 10px 10px; border:1px solid rgba(245,219,199,.46); background:rgba(24,20,25,.78); backdrop-filter:blur(8px); transition:transform .2s ease,border-color .2s ease; }
  .marscoin-identity:hover { transform:translateY(-4px); border-color:var(--paper); }
  .marscoin-identity img { width:124px; height:124px; object-fit:contain; flex:none; }
  .marscoin-identity > span { display:flex; flex-direction:column; gap:9px; }
  .marscoin-identity strong { font:400 15px/1.25 'Michroma',sans-serif; letter-spacing:.03em; }
  .marscoin-identity small { font-size:9px; font-weight:700; letter-spacing:.14em; white-space:nowrap; }
  .marscoin-identity small span { margin-left:9px; }
  .rewards-section { padding:90px 0 100px; background:radial-gradient(circle at 25% 60%,#3b343b 0%,#292429 44%,#211d23 100%); }
